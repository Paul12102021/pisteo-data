shire/belton-estate/belton-park-walk"},5270,[52.93017,-0.62591,52.94289,-0.60459],[384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399]],[20682916,"f",{"name":"Belton Estate Riverside Walk, Belton House","network":"lwn","distance":"2.2","operator":"National Trust","description":"This scenic riverside walk follows the River Witham as it meanders through Belton Park, a wildlife-rich open area of grassland & ancient woodland of around 1,300 acres with a historic herd of wild fallow deer. Uneven & sometimes muddy near the river edge.","website":"https://www.nationaltrust.org.uk/visit/nottinghamshire-lincolnshire/belton-estate/belton-house-riverside-walk"},2292,[52.93575,-0.62692,52.94306,-0.61856],[400,401,395,394,393,402,403,404,405,392,393,394,406,407,408,409,398,410,411]],[20683270,"f",{"name":"Tamper and Walk Trail, Belton House","network":"lwn","distance":"5.8","operator":"National Trust","description":"Suitable for all-terrain scooters (trampers) only. This route is step free, but goes over uneven grassland and is seasonally muddy. There are steeper gradients towards Old Wood, the Deer Sanctuary and Towthorpe Hollow Ponds. Accessible gates present.","website":"https://nt.global.ssl.fastly.net/binaries/content/assets/website/national/regions/nottinghamshire-lincolnshire/places/belton-estate/pdf/updated-belton-park-map.pdf"},5135,[52.93017,-0.62591,52.94176,-0.60459],[407,412,413,387,388,389,390,391,392,393,394,406]]],"w":[[39938136,"ut|aIrbqC{FdDw`@|O","ch"],[39938148,"gm|aIh}pCmFhD","pc"],[39938149,"ml|aI||pCYJ","pc"],[39938163,"}e|aIzwpCoE`D","pc"],[338626439,"{k|aIf`qCxBkBbA_D","pc"],[338626440,"ul|aI~~pCXf@","ch"],[338626441,"ul|aI~~pCHn@","pr"],[39936032,"kl|aIn`qCPt@","pr"],[39936012,"yk|aIdbqC~CfJp@hSPn@","pr"],[171970464,"qmnbIhloBi@sBgAM","ch"],[171970460,"q_nbIpupBsGsTkDsR","pr"],[171970457,"q_nbIpupB|@\\rDfIhBdBb@pA","rt"],[171970471,"qsmbInfqBF\\","rt"],[171970470,"ismbIlgqBx@xE","rt"],[171969843,"oqmbIfnqBVnA","rt"],[171969841,"wpmbIvpqBdEx