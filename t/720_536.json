69,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,218,217]],[8302621,"h",{"name":"Sos, De Gueyze à Meylan, au fil de la Gueyze 11.3 km","network":"lwn","distance":"11.3","operator":"CDT47","osmc:symbol":"blue:white:blue_bar","description":"Le sable des Landes et l'argile des vallées, la forêt cultivée de pins et celle plus ancienne et plus sauvage, de chênes, de noisetiers et d'acacias, voici une balade contrastée au cœur de la nature."},11441,[44.04229,0.11658,44.0792,0.13603],[296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,228,229,230,231,312,313,314,315,316,317,318,319,320,321,322,297,296]],[8302622,"h",{"name":"Sos, Meylan, balade entre pins et chênes 5.9 km","network":"lwn","distance":"5.9","operator":"CDT47","osmc:symbol":"yellow:white:yellow_bar","description":"Sur ce petit circuit contrasté vous découvrirez d'abord le sable des Landes et la forêt de pins cultivée au nord. Au sud le sol argileux de la vallée de la Gueyze est planté de chênes et de diverses essences de feuillus."},6282,[44.05876,0.11658,44.0792,0.1348],[296,297,298,299,323,313,314,315,316,317,318,319,320,321,322,297,296]],[8305906,"h",{"name":"De Mézin, la Médiévale à Poudenas, l'Italienne 14.3 km","network":"lwn","distance":"14.3","operator":"CDT47","osmc:symbol":"yellow:white:yellow_bar","description":"Mézin est une étape du chemin de St-Jacques-de-Compostelle, via Vézelay. Une statue en pierre d'un pèlerin avec ses attributs est visible dans l'église. Près de l'église, rue Cauzimis, un musée présente une famille de bouchonniers de 1906 à nos jours.","website":"http://rando.tourisme-lotetgaronne.com/#"},14187,[44.0433,0.20971,44.08047,0.25862],[245,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,259,260,261,262,263,340,268,270,271,272,273,274,341,342,343,344,345,346,347,348,349,350,351,352]],[8305946,"h",{"name":"De Mézin à Villeneuve-de-Mézin, sur la route de Compostelle 16.6 km","network":"lwn","distance":"16.6","operator":"CDT47","osmc:symbol":"blue:white:blue_bar","description":"Sur la première partie de ce circuit, vous accompagnerez les pèlerins en route vers Compostelle. Au coeur de cette boucle, vous pouvez rejoindre hors-sentier l'église de Trignan (12ème et 13ème siècles), qui fut une ancienne halte jacquaire.","website":"http://rando.tourisme-lotetgaronne.com/#"},18127,[44.01389,0.22443,44.05712,0.27159],[353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,345,346,347,348,349,350,351,352]],[8306086,"h",{"name":"Mézin, vers Nérac, avec le petit train touristique 19.6 km","network":"lwn","distance":"19.6","operator":"CDT47","osmc:symbol":"green:white:green_bar","description":"À la marge de la forêt landaise, Vous parcourrez des portions de différentes boucles et croiserez peut-être, entre Mézin et Cauderoue, des pèlerins de St-Jacques en route vers Compostelle. Retour par le train (vélos acceptés).","website":"http://rando.tourisme-lotetgaronne.com/#"},19600,[44.05575,0.24588,44.13853,0.33873],[382,383,329,328,327,326,325,324,384,385]],[8306736,"h",{"name":"Poudenas, une ambiance de Toscane variante 7.8 km","network":"lwn","distance":"7.8","operator":"CDT47","osmc:symbol":"yellow:white:yellow_bar","description":"Pour saisir l'esprit de ce petit pays qui rappelle l'Italie, cet itinéraire propose sur Poudenas des vues en contre-plongée depuis la Gélise, et des images panoramiques au passage sur les coteaux.","website":"http://rando.tourisme-lotetgaronne.com/#"},7610,[44.03544,0.19696,44.04519,0.23106],[386,273,274,245,246,247,275,276,387,388,389,390,391,392,393,394,379,380,381,344,343,342,341,245,274,273,386]],[8306737,"h",{"name":"Poudenas, une ambiance de Toscane 10.8 km","network":"lwn","distance":"10.8","operator":"CDT47","osmc:symbol":"yellow:white:yellow_bar","description":"Pour saisir l'esprit de ce petit pays qui rappelle l'Italie, cet itinéraire propose sur Poudenas des vues en contre-