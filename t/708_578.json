.org.uk/visit/lake-district/aira-force-and-gowbarrow-park/aira-force-and-gowbarrow-trail"},6847,[54.57159,-2.93151,54.58991,-2.90764],[486,89,487,488,489,490,491,492,493,109,110,111,494,494,111,110,109,108,107,106,105,104,103,102,495,496,497,498,499,95,94,93,92,91,90,500,501]],[19431062,"f",{"name":"Aira Force Glencoyne Farm Trail, Ullswater Valley","network":"lwn","distance":"4.8","operator":"National Trust","description":"Glencoyne is one of the largest tenanted hill farms in the Lake District. Pass through Grade II listed buildings, industrial artifacts, fells, grazing livestock, rich woodland where red squirrels are seen & views of Ullswater. Steep, gravel & boggy.","website":"https://www.nationaltrust.org.uk/visit/lake-district/aira-force-and-gowbarrow-park/aira-force-glencoyne-farm-trail"},2919,[54.55663,-2.96673,54.55965,-2.94835],[139,140,141,502,503,504,505,506,507,508,509,510,511,512,513,514,515]],[19431280,"f",{"name":"Hartsop to Hayeswater Gill Trail, Ullswater Valley","network":"lwn","distance":"3.2","operator":"National Trust","description":"From Hartsop village, follow Hayeswater Gill up to the reservoir (which once fed into north-west England's water supply) on a circular walk surrounded by towering Lake District fells. Discover local mining and milling history as you go. Some steep climbs.","website":"https://www.nationaltrust.org.uk/visit/lake-district/aira-force-and-gowbarrow-park/hartsop-to-hayeswater-gill-trail"},3337,[54.5064,-2.9127,54.50945,-2.89069],[516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,530,531,532,533,534,535,536,524,523,522,537,537,538]],[19431345,"f",{"name":"Patterdale and Glenamara Park Trail, Ullswater Valley","network":"lwn","distance":"3.2","operator":"National Trust","description":"With views of Ullswater & the surrounding fells, this circular is mainly gravel. See some of the Lake District's most striking ancient & veteran trees, including stately oaks & alder in the former deer enclosure of Glenamara Park. Gentle climbs & descents","website":"https://www.nationaltrust.org.uk/visit/lake-district/aira-force-and-gowbarrow-park/patterdale-and-glenamara-park-trail"},2791,[54.53083,-2.94945,54.53697,-2.93343],[539,540,262,261,260,259,258,257,256,255,254,253,252,251,250,249,541,542,543,159,158,544,539,545]],[19749379,"f",{"name":"Aira Force to Glencoyne Trail, Ullswater Valley","network":"lwn","distance":"1.9","operator":"National Trust","description":"A linear route from Aira Force to Glencoyne along the edge of Ullswater with views of the lake & fells. Blue Badge parking & a disabled toilet at the trail head. Includes up & downhill paths, steep climbs, steps & drop offs. Path narrows to 70cm.","website":"https://www.nationaltrust.org.uk/visit/lake-district/aira-force-and-gowbarrow-park/aira-to-glencoyne-trail"},2103,[54.56139,-2.95032,54.57243,-2.9283],[546,547,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,486,548,229,230,231,232,233]]],"w":[[480225265,"{omlI~plQu@mCyFaZ{DsLQ{CcA}@ZkBWqY}AuQoCiFoB{NcB{FsCkI_BqCcC{AiIuAqDsDmDqB{@SoA^gEuCgDaAaDOuF_GmBaAmCW_BdAsA@}An@u@bCmBr@_C?aFaFc@sBwFsD_MuEw@kAyB`@_AWgFkF","pr"],[23385629,"{srlI`gfQcB?{ExDuCn@{ErDkCdI","pr"],[165630893,"ymslId~fQ[J","pr"],[165630894,"unslIp~fQG?","pr"],[987218095,"ymslIbrfQk@fAR~EKdB","rt"],[23385628,"owrlIz|eQcDjBeCxFgCnBmBvCiDx@","rt"],[456983596,"yoqlIpjeQcR`AcKjJiDf@cBrB","rt"],[456983597,"inqlI|jeQo@K","rt"],[176242012,"kkolIbkeQmAz@mCVsNw@me@d@eBQyAu@","rt"],[1160636836,"qjolIljeQYT","rt"],[1160636835,"kjnlIf}dQ_KeC{@FwDnEqKrI","rt"],[1412989245,"kjnlIf}dQ?G","pc"],[814477257,"kjnlI~|dQp@q@PkSlC_j@AiC","pc"],[814477255,"{cnlIvwbQWc@C}E?ksB","pr"],[581639166,"wdnlIh{~P_B}Pi@_D","pc"],[814477254,"ainlIjd~Pw@cBmAoGmYwcB{@iH","pr"],[36882744,"ymolIj|yPdBjK`@|@","rt"],[23385711,"ahqlIvczPfy@kF","rt"],[22747003,"ahqlIvczPjCqvBGyFyBeTw@_DkLeXiJg\\o\\an@_LmQgImPy@y@cEy@","pr"],[78362094,"{~slId}pP}Fo@iAiAgFyKg@eCwAiN?gH","pr"],[78362049,"kvtlIhmoP~@nA","pr"],[616