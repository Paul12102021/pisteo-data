aliae.it/"},5707,[37.61922,13.4919,37.6271,13.52869],[376,377,378,379,380,120,381,122]],[15963344,"b",{"name":"Sicily Divide, Tappa 4","network":"rcn","distance":"60","website":"https://sicilydivide.it"},61669,[37.45364,13.4915,37.6397,13.81637],[382,316,383,318,384,107,385,386,387,388,389,304,303,2,302,301,300,299,298,337,390,391,339,340,341,392,393,394,395,396,397,398,157,399,400,401,159,160,161,162,163,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429]],[17385917,"h",{"name":"Magna Via Francigena: Tappa 7.1 Variante pioggia","network":"rwn","distance":"11","osmc:symbol":"red:white:red_hiker","description":"Questa preziosa variante permette da Campofranco di evitare il guado del fiume Gallo d'Oro che durante i mesi invernali e durante le pioggie intense diventa pericoloso da guadare. E' fortemente consigliata.","website":"https://www.viefrancigenedisicilia.it/tappa.php?idV=1&id=7"},10967,[37.46787,13.69151,37.51224,13.73697],[245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,430,431]],[17813407,"b",{"name":"ABT Tappa 43: Petralia Sottana - Alia","network":"ncn","distance":"82.5","website":"https://appenninobiketour.com/percorso/"},82410,[37.71262,13.70847,37.88035,14.10632],[432]]],"w":[[556823221,"ocvdFkxcrAx@`@UXl@Z{@b@f@d@UJfAb@q@\\UfA@p@j@HFj@","ch"],[556823748,"q`vdFkkcrACvB`@|D`Aj@YoBL}@XWj@VFb@`@SH\\","ch"],[413979931,"czudFidcrAHF","pr"],[556831104,"yyudFadcrApBkA`AoB`Ak@n@UvAJr@M","pr"],[413974033,"gludFalcrA`A][fAh@KxEmGf@Yk@rAn@W}@hCxAyAa@jAFb@`@N]~Ax@UQb@VE|@sAz@_@PHa@n@bAKUTzC`A_APfAXIHaBPrC|@aCj@rFbAhAlA","ch"],[556834497,"kntdFa_crAuCBwFxD","ch"],[556831106,"yztdFcybrArAZkBlBdCIaAbCa@lDl@cA|AiAs@xBWpB","ch"],[556831108,"oxtdFshbrAbAjBJtEZf@r@jEQbAdAjDjGpJ`CjHVxCp@~Bh@rAtFdHpCbBT~@|AlBhCvF\\dD^p@zB`@lEQn@~@d@PEe@p@yAXn@j@Gl@p@pBFn@mB^J","ch"],[556831109,"ssrdFwo_rAr@xB","ch"],[358817174,"_rrdF}k_rA|@tBM~@uHfD","ch"],[221077645,"ezrdF_a_rA_@DAg@aCf@cDtDcItFg@lBVlClD|Hb@J|AdDbCbDuG