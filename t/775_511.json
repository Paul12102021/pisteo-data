47,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,177,178,179]],[14872948,"h",{"name":"Via Normanna -Tappa 5","ref":"VNorm5","network":"rwn","distance":"20.31","operator":"vie Francigene di Sicilia","osmc:symbol":"red:white:green_hiker","description":"Si giunge nei pressi di una delle piccole perle del Cammino, il borgo di Sclafani Bagni, famosa per le sue acque termali che dal XVII secolo sono visitate dai viandanti. Si prosegue il percorso fino a Caltavuturo, borgo madonita di origini arabe","website":"https://www.viefrancigenedisicilia.it/PaMe.php"},20281,[37.81904,13.7611,37.8472,13.88989],[180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227]],[14873014,"h",{"name":"Via Normanna-Tappa 4","ref":"VNorm4","network":"rwn","distance":"16.66","operator":"vie Francigene di Sicilia","osmc:symbol":"red:white:green_hiker","description":"Dalle piane dei fiumi San Leonardo e Torto, confluenza di genti che hanno colonizzato queste valli dal tempo dei sicani e dei greci, lo scenario del Cammino muta verso le pendici delle Madonie. Iniziano le prime salite dell'Appennino siculo.","website":"https://www.viefrancigenedisicilia.it/PaMe.php"},16501,[37.8472,13.66069,37.93209,13.76164],[4,5,228,229,230,231,232]],[14894428,"h",{"name":"Sentiero Portella Colla – Case Disiceddi (Piano Cervi)","ref":"561","network":"lwn","distance":"9.9","osmc:symbol":"red:red:white_stripe:561:black","website":"https://www.cefalumadoniehimera.it/trails/561-sentiero-portella-colla-case-disiceddi-piano-cervi/"},9542,[37.86754,13.96028,37.89649,14.00495],[82,233,80,234,78,235,236,237,238]],[14894767,"h",{"name":"Sentiero Gratteri – Isnello passando da Pizzo Dipilo","ref":"601","network":"lwn","distance":"8.6","osmc:symbol":"red:red:white_stripe:601:black","description":"Questo sentiero collega la cit